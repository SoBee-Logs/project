# ── RDS (공유 DB) ───────────────────────────────────────────────────────────
DB_HOST=your-rds-host.rds.amazonaws.com
DB_PORT=3306
DB_NAME=sobee
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=sobee-secret-key-for-jwt-token-generation-must-be-long-enough
JWT_EXPIRATION_MS=86400000

# ── AWS ─────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=sobee-prd-s3-media

# ── AI / LLM ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Internal API ────────────────────────────────────────────────────────────
INTERNAL_SECRET_KEY=your_internal_secret

# ── Codef (마이데이터) ─────────────────────────────────────────────────────
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=
# CODEF_ACCOUNT_1=user_id,BK,0020,myid,mypw
